{
  "name": "kql-assistant",
  "displayName": "KQL Assistant",
  "description": "Offline KQL syntax and schema validation, custom schema support, IntelliSense, formatting, quick fixes, and query organization for Azure Log Analytics and Sentinel",
  "version": "0.9.1",
  "publisher": "petstuk",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/petstuk/kql-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/petstuk/kql-assistant/issues"
  },
  "homepage": "https://github.com/petstuk/kql-assistant#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "kql",
    "kusto",
    "azure data explorer",
    "log analytics",
    "sentinel",
    "microsoft sentinel",
    "azure monitor",
    "syntax checking",
    "linter",
    "security",
    "detection rules",
    "siem"
  ],
  "activationEvents": [
    "onLanguage:kql"
  ],
  "main": "./out/src/extension.js",
  "bin": {
    "kql-assistant": "./out/src/cli.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "kql",
        "aliases": [
          "KQL",
          "Kusto Query Language"
        ],
        "extensions": [
          ".kql",
          ".kusto"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kql",
        "scopeName": "source.kql",
        "path": "./syntaxes/kql.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kql-assistant.checkSyntax",
        "title": "KQL: Check Syntax"
      },
      {
        "command": "kql-assistant.selectCurrentQuery",
        "title": "KQL: Select Current Query"
      },
      {
        "command": "kql-assistant.copyCurrentQuery",
        "title": "KQL: Copy Current Query"
      },
      {
        "command": "kql-assistant.ignoreUnknownTable",
        "title": "KQL: Ignore Unknown Table"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "KQL Assistant",
      "properties": {
        "kqlAssistant.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable KQL syntax checking and diagnostics"
        },
        "kqlAssistant.diagnosticLevel": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information"
          ],
          "default": "error",
          "description": "Severity level for syntax diagnostics"
        },
        "kqlAssistant.userSchemaPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a JSON schema file (same format as bundled schemas). Relative paths resolve from the workspace folder. Merged over bundled tables."
        },
        "kqlAssistant.ignoredTables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Table names to skip when reporting unknown-table diagnostics (case-insensitive). Also set via the Ignore unknown table lightbulb."
        },
        "kqlAssistant.lintMode": {
          "type": "string",
          "enum": [
            "off",
            "basic",
            "strict"
          ],
          "default": "basic",
          "description": "Detection/cost lint pack: off, basic (time filter, contains→has, bare search, join kind), or strict (adds project-after-join guidance; stronger severities)."
        },
        "kqlAssistant.schemaPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "all",
              "sentinel-core",
              "mde",
              "identity",
              "asim",
              "asim-parsers"
            ]
          },
          "default": [
            "all"
          ],
          "description": "Schema packs to load. Use \"all\" for the full catalog (default). Combine packs (e.g. mde + sentinel-core) to reduce completion noise. asim / asim-parsers also merge _Im_* parser stubs."
        }
      }
    },
    "snippets": [
      {
        "language": "kql",
        "path": "./snippets/kql.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha \"out/test/**/*.test.js\"",
    "lint": "eslint src test --ext ts",
    "lint:kql": "node out/src/cli.js lint",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "mocha": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.19.0",
    "eslint": "^8.45.0",
    "pdf-parse": "^2.2.2",
    "typescript": "^5.1.6"
  }
}
